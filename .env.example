# Modele de configuration : copiez ce fichier en .env, puis lancez docker compose up -d --build
# Toutes ces valeurs sont des valeurs de DEMONSTRATION. Pour une vraie mise en service,
# remplacez chaque secret (./faso init en genere de nouveaux) et mettez un vrai domaine.

FASO_DOMAINE=faso.localhost
FASO_SERVER_NAME=faso.gov.bf

POSTGRES_PASSWORD=demo-postgres-a-remplacer
KEYCLOAK_DB_PASSWORD=demo-keycloak-db-a-remplacer
KEYCLOAK_ADMIN=admin-faso
KEYCLOAK_ADMIN_PASSWORD=demo-admin-a-remplacer

SYNAPSE_OIDC_SECRET=demo-synapse-oidc-a-remplacer
SYNAPSE_REGISTRATION_SHARED_SECRET=demo-enregistrement-a-remplacer-0123456789abcdef
SYNAPSE_MACAROON_SECRET=demo-macaroon-a-remplacer-0123456789abcdef
SYNAPSE_FORM_SECRET=demo-formulaire-a-remplacer-0123456789abcdef

CONSOLE_OIDC_SECRET=demo-console-oidc-a-remplacer
CONSOLE_SESSION_SECRET=demo-session-a-remplacer-0123456789abcdef0123456789abcdef
CONSOLE_API_JETON=demo-jeton-api-a-remplacer-0123456789abcdef
