version: 1

formatters:
  precis:
    format: "%(asctime)s %(levelname)s %(name)s %(request)s %(message)s"

handlers:
  console:
    class: logging.StreamHandler
    formatter: precis
    filters: [contexte]

filters:
  contexte:
    (): synapse.logging.context.LoggingContextFilter
    request: ""

loggers:
  synapse.storage.SQL:
    level: WARNING
  faso_cikan:
    level: INFO

root:
  level: INFO
  handlers: [console]

disable_existing_loggers: false
